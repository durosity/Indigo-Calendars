            <Field id="priorityToday" type="menu" defaultValue="1">
                <Label>Today:</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                    <Option value="7">7</Option>
                    <Option value="8">8</Option>
                    <Option value="9">9 - Lowest</Option>
                </List>
            </Field>
            
            <Field id="priorityTomorrow" type="menu" defaultValue="2">
                <Label>Tomorrow:</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                    <Option value="7">7</Option>
                    <Option value="8">8</Option>
                    <Option value="9">9 - Lowest</Option>
                </List>
            </Field>
            
            <Field id="priorityFuture" type="menu" defaultValue="3">
                <Label>Future (after tomorrow):</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                    <Option value="7">7</Option>
                    <Option value="8">8</Option>
                    <Option value="9">9 - Lowest</Option>
                </List>
            </Field>
            
            <Field id="priorityYesterday" type="menu" defaultValue="4">
                <Label>Yesterday:</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                    <Option value="7">7</Option>
                    <Option value="8">8</Option>
                    <Option value="9">9 - Lowest</Option>
                </List>
            </Field>
            
            <Field id="priorityOlder" type="menu" defaultValue="5">
                <Label>Older (before yesterday):</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                    <Option value="7">7</Option>
                    <Option value="8">8</Option>
                    <Option value="9">9 - Lowest</Option>
                </List>
            </Field>
            
            <Field id="priorityUndated" type="menu" defaultValue="6">
                <Label>Undated (no due date):</Label>
                <List>
                    <Option value="1">1 - Highest</Option>
                    <Option value="2">2</Option>
                    <Option value="3">3</Option>
                    <Option value="4">4</Option>
                    <Option value="5">5</Option>
                    <Option value="6">6</Option>
                </List>
            </Field>
            
            <Field id="separator2a" type="separator"/>
            
            <Field id="prioritizeHighPriority" type="checkbox" defaultValue="false">
                <Label>High Priority (!!) tasks show at top of day's list:</Label>
                <Description>Within each day category, high priority tasks appear first</Description>
            </Field>
            
            <Field id="separator3" type="separator"/>
            
            <Field id="separator4" type="separator"/>
            
            <Field id="refreshInterval" type="menu" defaultValue="300">
                <Label>Auto-Refresh Interval:</Label>
                <List>
                    <Option value="0">Disabled</Option>
                    <Option value="60">1 minute</Option>
                    <Option value="300">5 minutes</Option>
                    <Option value="600">10 minutes</Option>
                    <Option value="900">15 minutes</Option>
