<?xml version="1.0"?>
<Devices>
    <Device type="sensor" id="calendar">
        <Name>Calendar</Name>
        <UiDisplayStateId>lastUpdate</UiDisplayStateId>
        <ConfigUI>
            <Field id="calendarListLabel" type="label">
                <Label>Calendar Selection:</Label>
            </Field>
            
            <Field id="refreshCalendarList" type="button">
                <Label>Refresh Available Calendars</Label>
                <Title>Refresh</Title>
                <CallbackMethod>refresh_calendar_list</CallbackMethod>
            </Field>
            
            <Field id="selectedCalendars" type="list">
                <Label>Calendars to Monitor:</Label>
                <List class="self" method="get_calendar_list" dynamicReload="true"/>
            </Field>
            
            <Field id="separator1" type="separator"/>
            
            <Field id="eventCount" type="textfield" defaultValue="7">
                <Label>Number of Events to Import:</Label>
            </Field>
            
            <Field id="daysAhead" type="menu" defaultValue="60">
                <Label>Days Ahead to Fetch:</Label>
                <List>
                    <Option value="7">7 days (1 week)</Option>
                    <Option value="14">14 days (2 weeks)</Option>
                    <Option value="30">30 days (1 month)</Option>
                    <Option value="60">60 days (2 months)</Option>
                    <Option value="90">90 days (3 months)</Option>
                </List>
            </Field>
            
            <Field id="removeDuplicates" type="checkbox" defaultValue="true">
                <Label>Remove Duplicate Events:</Label>
                <Description>Remove recurring event instances that appear multiple times</Description>
            </Field>
            
            <Field id="filterKeywords" type="textfield">
                <Label>Filter Keywords (exclude events):</Label>
                <Description>Comma-separated keywords to exclude (e.g., "Scotland, Wales, Ireland")</Description>
            </Field>
            
            <Field id="separator2" type="separator"/>
            
            <Field id="refreshInterval" type="menu" defaultValue="300">
                <Label>Auto-Refresh Interval:</Label>
                <List>
                    <Option value="0">Disabled</Option>
                    <Option value="60">1 minute</Option>
                    <Option value="300">5 minutes</Option>
                    <Option value="600">10 minutes</Option>
                    <Option value="900">15 minutes</Option>
                    <Option value="1800">30 minutes</Option>
                    <Option value="3600">1 hour</Option>
                </List>
            </Field>
            
            <Field id="debugLogging" type="checkbox" defaultValue="false">
                <Label>Enable Debug Logging:</Label>
            </Field>
        </ConfigUI>
        
        <States>
            <State id="lastUpdate">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Update</TriggerLabel>
                <ControlPageLabel>Last Update</ControlPageLabel>
            </State>
            <State id="eventCount">
                <ValueType>Number</ValueType>
                <TriggerLabel>Event Count</TriggerLabel>
                <ControlPageLabel>Event Count</ControlPageLabel>
            </State>
        </States>
    </Device>
    
    <!-- Reminders Device -->
    <Device type="sensor" id="reminders">
        <Name>Reminders</Name>
        <UiDisplayStateId>lastUpdate</UiDisplayStateId>
        <ConfigUI>
            <Field id="reminderListLabel" type="label">
                <Label>Reminder List Selection:</Label>
            </Field>
            
            <Field id="refreshReminderList" type="button">
                <Label>Refresh Available Lists</Label>
                <Title>Refresh</Title>
